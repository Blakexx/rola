# K37 -- ONE Python lock file, source of the dev container's environment.
#
# HOW THIS WAS DERIVED: `pip freeze` on the hand-grown dev venv this box
# iterated in (the pre-container `rola311` environment), PRUNED to what the
# repo actually imports (`pyproject.toml`
# `dependencies`/`optional-dependencies`, plus a grep of `rola/`, `tests/`,
# `tools/`, `benchmarks/` for top-level imports) -- not the whole 101-package
# freeze, which also carries training-loop packages (`wandb`, `accelerate`,
# `transformers`, ...) this repository's OWN test/dev/bench extras never import.
# Anything present in the pruned freeze is pinned to the EXACT version measured
# there, so the lock reproduces the environment the closed-world gates were last
# proven against. `hypothesis` and the `dev`/`bench` extras' `ruff`/`pytest-xdist`
# were NOT in that venv (never installed there) -- pinned here to a current
# release instead, called out so a reader does not mistake "not in rola311" for
# "measured and pinned to that version".
#
# Compiled with `uv pip compile requirements.in --python-version 3.11
# --extra-index-url https://download.pytorch.org/whl/cu130
# --index-strategy unsafe-best-match -o requirements.lock` (uv being present
# on this box -- the card's "uv lock, or pip-compile if uv isn't available").
# The extra index is required because a plain PyPI resolve of `torch` fetches
# the CPU-only wheel, which is exactly the trap `docs/build.md` and
# `pyproject.toml`'s `[build-system]` comment both name for the build itself.

# --- pyproject.toml's runtime dependencies ---
# torch for the cu13 toolchain's CUDA major, from its `torch_index` (tools/toolchains/cu13.json).
torch==2.14.0+cu130
einops==0.8.2

# --- [bench] extra: benchmarks/ plotting and result tables ---
matplotlib
pandas==3.0.3

# --- [test] extra: the oracle/routing gate reference + xdist ---
entmax==1.3
pytest-xdist==3.8.0

# --- [dev] extra: the commit gate's tools, at the versions .pre-commit-config.yaml and CI pin, so the gate runs from
# this venv and never from a tool the host happens to have ---
ruff==0.14.10
pre-commit==4.6.2
vulture==2.16
clang-format==19.1.7
ast-grep-cli==0.45.2

# --- shared pytest core (rola311-measured versions) ---
pytest==9.1.1
pytest-json-report==1.5.0
pytest-metadata==3.1.1

# --- card K37 explicit adds, not previously in any extra ---
pytest-timeout==2.4.0
hypothesis==6.165.10

# --- setup.py's [build-system] requires (torch excluded there for the
# no-build-isolation reason above; the rest are ordinary build deps) ---
setuptools>=61
wheel
packaging
psutil==7.2.2
ninja==1.13.0
