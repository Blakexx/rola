"""THE TREE'S TOOLS AS THE GRAPH'S INPUTS: the pins and records the graph's repositories read, and the generators its
actions run."""

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//bazel:cuda.bzl", "cuda_unit")
load("//bazel:defs.bzl", "tool_run", "tree_part")

package(default_visibility = ["//visibility:public"])

exports_files(glob([
    "*.py",
    "*.json",
    "toolchains/*.json",
    "manifests/*.json",
    "manifests/*/*.json",
]))

filegroup(
    name = "manifests_cu13",
    srcs = glob(["manifests/cu13/*.json"]),
)

filegroup(
    name = "toolchain_records",
    srcs = glob(["toolchains/*.json"]),
)

filegroup(
    name = "budgets",
    srcs = glob(["budgets/**"]),
)

#: the tools' Python and the lints', which the gates import
filegroup(
    name = "python_sources",
    srcs = glob(["*.py"]) + ["//tools/lint:python_sources"],
)

#: this package's part of the tree the checks read
tree_part(parts = {"manifests": "manifests/"})

#: THE DERIVATION'S GOLDEN HARNESS, rendered from the declared cases and built as the extension's units are: ratify runs
#: it in place of its own compile (docs/internals/tools/ratify.md#graph). It names the smallest tabulated architecture,
#: as ratify's compile does: the derivation is the same on every tabulated card
genrule(
    name = "derivation_harness_source",
    srcs = ["manifests/derivation_cases.json"],
    outs = ["derivation/derivation_harness.cu"],
    cmd = "$(execpath @rola_env//:python) $(execpath derivation.py) --cases $(execpath manifests/derivation_cases.json) --out $@",
    tools = [
        "derivation.py",
        "@rola_env//:python",
    ],
)

cuda_unit(
    name = "derivation_unit",
    srcs = [":derivation_harness_source"],
    archs = ["compute_80:sm_80"],
    copts = [
        "-std=c++20",
        "-O0",
    ],
    host_cc = "@host_cc//:identity.txt",
    deps = ["//csrc/rola:headers"],
)

cc_binary(
    name = "derivation_harness",
    deps = [
        ":derivation_unit",
        "@cuda//:cuda_runtime_static",
    ],
)

#: THE TREE'S TOOLS, each a run target (bazel/defs.bzl's `tool_run`): `bazel run //tools:<name> -- <its arguments>`, in
#: the checkout on its own venv (docs/build-graph.md#use)
[tool_run(
    name = name,
    tool = "tools/%s.py" % name,
) for name in [
    "bank_model",
    "burst_gate",
    "carve_model",
    "compose_ledger",
    "design_floor",
    "factor_census",
    "gen_shards",
    "header_selfcheck",
    "kernel_targets",
    "kernels",
    "lab",
    "life_ranges",
    "op_timeline",
    "overlap_gate",
    "phase_ledger",
    "pipe_counters",
    "pipe_sim",
    "pipe_timeline",
    "quality",
    "readout_scaling",
    "realized_support",
    "region_ledger",
    "review_gate",
    "roofline",
    "sanitize_cell",
    "sass_bodies",
    "sass_gate",
    "scale_slack",
    "stall_census",
    "supported",
    "wheels",
]]

