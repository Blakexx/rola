{
  // THE DEV CONTAINER (docs/setup.md, KERNEL_STANDARDS §23). The image is `Dockerfile`, built for the current
  // environment key; the mounts -- this checkout, the host's lock directories, the measurements store and the
  // worktrees folder -- come from the host's dev config through `python3 tools/dev.py container compose`, which
  // writes `compose.local.yaml` (not committed). Every setting inside is the image's dev config
  // (ROLA_DEV_CONFIG=/opt/rola/dev-config), written at image build by the same `tools/dev.py init` a bare host runs.
  "name": "rola-dev",
  "initializeCommand": "python3 tools/dev.py container compose",
  "dockerComposeFile": ["compose.yaml", "compose.local.yaml"],
  "service": "rola",
  "workspaceFolder": "/workspace/rola",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-python.python",
        "charliermarsh.ruff",
        "nvidia.nsight-vscode-edition"
      ],
      "settings": {
        "clangd.path": "/usr/local/bin/clangd",
        "python.defaultInterpreterPath": "/opt/venv/bin/python3"
      }
    }
  },
  "postCreateCommand": "python tools/dev.py check"
}
