{
  // THE DEV CONTAINER (docs/setup.md#the-devbox-image, KERNEL_STANDARDS §23): the devbox image (`//:image`) on the
  // devbox's own volumes -- its home (/root: the pinned tools, Bazel's caches, the environment store) and its
  // workspace (/workspace: the checkouts, cloned inside) -- with the host's locks and, under WSL, the driver's
  // libraries. `bazel run //:container_compose` hands the image to Docker and writes `compose.local.yaml` (not
  // committed). Inside, the host's loop: clone the checkouts into /workspace, then `python3 tools/bootstrap.py`,
  // `bazel run //:init` and `bazel run //:dev_env` in /workspace/rola.
  "name": "rola-devbox",
  "initializeCommand": "bazel run //:container_compose",
  "dockerComposeFile": ["compose.yaml", "compose.local.yaml"],
  "service": "rola",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-python.python",
        "charliermarsh.ruff",
        "nvidia.nsight-vscode-edition"
      ],
      "settings": {
        "clangd.path": "/workspace/venv-rola/bin/clangd",
        "python.defaultInterpreterPath": "/workspace/venv-rola/bin/python"
      }
    }
  }
}
